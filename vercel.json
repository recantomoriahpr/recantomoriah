{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "routes": [
    { "src": "^/api/(.*)$", "dest": "/api/$1" },
    { "handle": "filesystem" },
    { "src": "^/(favicon\\.ico|robots\\.txt|sitemap\\.xml)$", "dest": "/$1" },
    { "src": "^/assets/(.*)$", "dest": "/assets/$1" },
    { "src": "^(?!/api/).*$", "dest": "/" }
  ]
}
